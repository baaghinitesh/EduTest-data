    {
      "type": "heading",
      "text": "Kinematics — Equations of Motion"
    },
    {
      "type": "list",
      "items": [
        "v = u + at",
        "s = ut + ½at²",
        "v² = u² + 2as",
        "s_n = u + a(2n-1)/2  [distance in nth second]"
      ]
    },
    {
      "type": "heading",
      "text": "Projectile Motion"
    },
    {
      "type": "list",
      "items": [
        "Time of flight: T = 2u·sinθ / g",
        "Maximum height: H = u²·sin²θ / 2g",
        "Horizontal range: R = u²·sin2θ / g",
        "Maximum range at θ = 45°: R_max = u²/g"
      ]
    },
    {
      "type": "heading",
      "text": "Newton's Laws"
    },
    {
      "type": "list",
      "items": [
        "1st Law: A body remains at rest or in uniform motion unless acted upon by a net external force",
        "2nd Law: F = ma (net force = mass × acceleration)",
        "3rd Law: For every action, there is an equal and opposite reaction"
      ]
    },
    {
      "type": "heading",
      "text": "Work, Energy & Power"
    },
    {
      "type": "list",
      "items": [
        "Work: W = F·d·cosθ",
        "Kinetic Energy: KE = ½mv²",
        "Potential Energy: PE = mgh",
        "Work-Energy Theorem: W_net = ΔKE",
        "Power: P = W/t = F·v",
        "Conservation of Energy: KE + PE = constant (no friction)"
      ]
    },
    {
      "type": "heading",
      "text": "Friction"
    },
    {
      "type": "list",
      "items": [
        "Static friction: f_s ≤ μ_s × N",
        "Kinetic friction: f_k = μ_k × N",
        "μ_s > μ_k always",
        "Angle of friction: tanφ = μ",
        "Angle of repose = Angle of friction"
      ]
    },
    {
      "type": "heading",
      "text": "Circular Motion"
    },
    {
      "type": "list",
      "items": [
        "Centripetal acceleration: a_c = v²/r = ω²r",
        "Centripetal force: F_c = mv²/r",
        "Angular velocity: ω = 2π/T = 2πf",
        "For vertical circle (min speed at top): v_min = √(gr)"
      ]
    },
    {
      "type": "heading",
      "text": "Important Constants"
    },
    {
      "type": "list",
      "items": [
        "g = 9.8 m/s² ≈ 10 m/s² (for calculations)",
        "G = 6.67 × 10⁻¹¹ N·m²/kg²",
        "1 kWh = 3.6 × 10⁶ J"
      ]
    }
  ]
}
