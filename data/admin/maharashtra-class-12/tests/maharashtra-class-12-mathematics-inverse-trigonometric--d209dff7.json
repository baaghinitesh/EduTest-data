    {
      "id": "q-1793641626159-3636b",
      "order": 13,
      "question": "If 0 < x < 1, then cos(sin⁻¹(x)) is equal to:",
      "type": "mcq",
      "options": [
        {
          "letter": "A",
          "text": "√(1 - x²)",
