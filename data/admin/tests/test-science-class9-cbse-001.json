    {
      "id": "q9", "order": 9,
      "question": "The weight of an object of mass 10 kg on Earth (g = 9.8 m/s²) is:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "10 N",  "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "9.8 N", "isCorrect": false, "index": 1 },
        { "letter": "C", "text": "98 N",  "isCorrect": true,  "index": 2 },
        { "letter": "D", "text": "980 N", "isCorrect": false, "index": 3 }
      ],
      "explanation": "Weight W = mg = 10 × 9.8 = 98 N.",
      "hint": "Weight = mass × g."
    },
