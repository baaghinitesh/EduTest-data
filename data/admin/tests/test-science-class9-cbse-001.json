      "id": "q1", "order": 1,
      "question": "Newton's First Law of Motion is also called:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "Law of Acceleration",  "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "Law of Inertia",       "isCorrect": true,  "index": 1 },
        { "letter": "C", "text": "Law of Action-Reaction","isCorrect": false,"index": 2 },
        { "letter": "D", "text": "Law of Momentum",      "isCorrect": false, "index": 3 }
      ],
      "explanation": "Newton's First Law states that a body continues in its state of rest or uniform motion unless acted upon by an external force — this is the law of inertia.",
      "hint": "Think about what 'inertia' means."
    },
    {
      "id": "q2", "order": 2,
      "question": "The SI unit of force is:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "Dyne",   "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "Joule",  "isCorrect": false, "index": 1 },
        { "letter": "C", "text": "Newton", "isCorrect": true,  "index": 2 },
        { "letter": "D", "text": "Pascal", "isCorrect": false, "index": 3 }
      ],
      "explanation": "The SI unit of force is Newton (N), named after Sir Isaac Newton.",
      "hint": "Named after the scientist who formulated the laws of motion."
    },
    {
      "id": "q3", "order": 3,
      "question": "A body of mass 5 kg is acted upon by a force of 20 N. Its acceleration is:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "2 m/s²",  "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "4 m/s²",  "isCorrect": true,  "index": 1 },
        { "letter": "C", "text": "100 m/s²","isCorrect": false, "index": 2 },
        { "letter": "D", "text": "0.25 m/s²","isCorrect": false,"index": 3 }
      ],
      "explanation": "F = ma, so a = F/m = 20/5 = 4 m/s².",
      "hint": "Use Newton's Second Law: F = ma."
    },
    {
      "id": "q4", "order": 4,
      "question": "Which of the following has the greatest inertia?",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "A cricket ball",  "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "A bicycle",       "isCorrect": false, "index": 1 },
        { "letter": "C", "text": "A truck",         "isCorrect": true,  "index": 2 },
        { "letter": "D", "text": "A tennis ball",   "isCorrect": false, "index": 3 }
      ],
      "explanation": "Inertia depends on mass. A truck has the greatest mass among the options, so it has the greatest inertia.",
      "hint": "Inertia is directly proportional to mass."
    },
    {
      "id": "q5", "order": 5,
      "question": "Newton's Third Law states that every action has an equal and opposite:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "Force",    "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "Reaction", "isCorrect": true,  "index": 1 },
        { "letter": "C", "text": "Momentum", "isCorrect": false, "index": 2 },
        { "letter": "D", "text": "Velocity", "isCorrect": false, "index": 3 }
      ],
      "explanation": "Newton's Third Law: For every action, there is an equal and opposite reaction.",
      "hint": "This is the action-reaction law."
    },
    {
      "id": "q6", "order": 6,
      "question": "The momentum of a body of mass 2 kg moving at 5 m/s is:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "2.5 kg·m/s","isCorrect": false,"index": 0 },
        { "letter": "B", "text": "7 kg·m/s",  "isCorrect": false, "index": 1 },
        { "letter": "C", "text": "10 kg·m/s", "isCorrect": true,  "index": 2 },
        { "letter": "D", "text": "3 kg·m/s",  "isCorrect": false, "index": 3 }
      ],
      "explanation": "Momentum p = mv = 2 × 5 = 10 kg·m/s.",
      "hint": "Momentum = mass × velocity."
    },
    {
      "id": "q7", "order": 7,
      "question": "The value of acceleration due to gravity on Earth's surface is approximately:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "6.67 × 10⁻¹¹ m/s²","isCorrect": false,"index": 0 },
        { "letter": "B", "text": "9.8 m/s²",          "isCorrect": true,  "index": 1 },
        { "letter": "C", "text": "10.8 m/s²",         "isCorrect": false, "index": 2 },
        { "letter": "D", "text": "8.9 m/s²",          "isCorrect": false, "index": 3 }
      ],
      "explanation": "The standard value of g on Earth's surface is 9.8 m/s² (often approximated as 10 m/s²).",
      "hint": "This is a standard constant you should memorise."
