    {
      "id": "q8", "order": 8,
      "question": "A rocket works on the principle of:",
      "type": "mcq", "marks": 3,
      "options": [
        { "letter": "A", "text": "Newton's First Law",  "isCorrect": false, "index": 0 },
        { "letter": "B", "text": "Newton's Second Law", "isCorrect": false, "index": 1 },
        { "letter": "C", "text": "Newton's Third Law",  "isCorrect": true,  "index": 2 },
        { "letter": "D", "text": "Law of Gravitation",  "isCorrect": false, "index": 3 }
      ],
      "explanation": "A rocket expels gases backward (action), and the reaction force propels the rocket forward — Newton's Third Law.",
      "hint": "Think about what pushes the rocket forward."
