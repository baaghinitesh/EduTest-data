          "text": "Three real roots",
          "isCorrect": false,
          "index": 3,
          "imageUrl": "",
          "explanation": ""
        }
      ],
      "answer": "",
      "alternateAnswers": [],
      "explanation": "When the discriminant $D = 0$, the quadratic equation has two equal (coincident) real roots given by $-\\frac{b}{2a}$.",
