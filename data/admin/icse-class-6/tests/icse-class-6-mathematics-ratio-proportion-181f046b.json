    {
      "id": "q-1779019923366-43e99",
      "order": 18,
      "question": "Are the numbers 2, 3, 8, 12 in proportion?",
      "type": "mcq",
      "options": [
        {
          "letter": "A",
          "text": "Yes, because 2/3 = 8/12",
          "isCorrect": false,
          "index": 0,
          "imageUrl": "",
          "explanation": "Partially correct explanation"
        },
        {
          "letter": "B",
          "text": "No, because 2+3 is not equal to 8+12",
          "isCorrect": false,
          "index": 1,
          "imageUrl": "",
          "explanation": "Incorrect explanation"
        },
        {
          "letter": "C",
          "text": "Yes, because 2*12 = 3*8",
          "isCorrect": true,
          "index": 2,
          "imageUrl": "",
          "explanation": "Correct explanation"
        },
        {
          "letter": "D",
          "text": "No, because their sum is not equal",
          "isCorrect": false,
          "index": 3,
          "imageUrl": "",
          "explanation": "Incorrect explanation"
        }
      ],
      "answer": "",
      "alternateAnswers": [],
      "explanation": "Four numbers a, b, c, d are in proportion if a:b :: c:d, which means a/b = c/d. This is equivalent to saying that the product of the extremes equals the product of the means (a*d = b*c). For 2, 3, 8, 12: Check the ratio of the first two: 2/3 Check the ratio of the last two: 8/12 = (8÷4)/(12÷4) = 2/3 Since 2/3 = 8/12, the numbers are in proportion. Alternatively, check the product of extremes and means: 2 * 12 = 24 3 * 8 = 24 Since 24 = 24, the numbers are in proportion.",
      "hint": "",
      "marks": 1,
      "negativeMark": 0,
      "negativeMarking": false,
      "imageUrl": "",
      "subject": "icse6-maths",
      "difficulty": "medium",
      "hasError": false
    },
