    {
      "id": "q-1781789186004-xy27w",
      "question": "A density bottle is used to find the relative density of a liquid. If the mass of an empty bottle ($M_1$) is $25\\text{ g}$, the mass of the bottle filled with water ($M_2$) is $55\\text{ g}$, and the mass of the bottle filled with liquid ($M_3$) is $49\\text{ g}$, what is the relative density of the liquid?",
      "type": "mcq",
      "options": [
        {
          "letter": "A",
          "text": "0.6",
          "isCorrect": false,
          "index": 0,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "B",
          "text": "0.7",
          "isCorrect": false,
          "index": 1,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "C",
          "text": "0.8",
          "isCorrect": true,
          "index": 2,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "D",
          "text": "0.9",
          "isCorrect": false,
          "index": 3,
          "imageUrl": "",
          "explanation": ""
        }
      ],
      "answer": "",
      "alternateAnswers": [],
      "explanation": "Relative Density = $(M_3 - M_1) / (M_2 - M_1) = (49 - 25) / (55 - 25) = 24 / 30 = 0.8$.",
      "hint": "The formula is the ratio of the mass of the liquid to the mass of an equal volume of water.",
