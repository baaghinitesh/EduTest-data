    {
      "id": "q-1788954784815-d78a1",
      "order": 24,
      "question": "A woman weighing 600 N stands on her heels, with the total area of contact being 20 cm². What is the pressure exerted on the ground in Pascals?",
      "type": "mcq",
      "options": [
        {
          "letter": "A",
          "text": "300 Pa",
          "isCorrect": false,
          "index": 0,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "B",
          "text": "3000 Pa",
          "isCorrect": false,
          "index": 1,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "C",
          "text": "30000 Pa",
          "isCorrect": false,
          "index": 2,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "D",
          "text": "300000 Pa",
          "isCorrect": true,
          "index": 3,
          "imageUrl": "",
          "explanation": ""
        }
      ],
      "answer": "",
      "alternateAnswers": [],
      "explanation": "Given: Force (F) = 600 N (weight of the woman) Area (A) = 20 cm² First, convert the area from cm² to m²: 1 m² = 10000 cm² So, A = 20 cm² / 10000 cm²/m² = 0.002 m² Formula: Pressure (P) = Force (F) / Area (A) Calculation: P = 600 N / 0.002 m² = 300000 N/m² = 300000 Pa.",
      "hint": "",
      "marks": 1,
      "negativeMark": 0,
      "negativeMarking": false,
      "imageUrl": "",
      "subject": "icse8-physics",
      "difficulty": "medium",
      "hasError": false
    },
