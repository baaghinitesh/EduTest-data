    {
      "id": "q-1788954784815-50b1f",
      "order": 23,
      "question": "A force of 150 N acts on a surface with an area of 0.5 m². Calculate the pressure exerted on the surface.",
      "type": "mcq",
      "options": [
        {
          "letter": "A",
          "text": "75 Pa",
          "isCorrect": false,
          "index": 0,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "B",
          "text": "150 Pa",
          "isCorrect": false,
          "index": 1,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "C",
          "text": "200 Pa",
          "isCorrect": false,
          "index": 2,
          "imageUrl": "",
          "explanation": ""
        },
        {
          "letter": "D",
          "text": "300 Pa",
          "isCorrect": true,
          "index": 3,
          "imageUrl": "",
          "explanation": ""
        }
      ],
      "answer": "",
      "alternateAnswers": [],
      "explanation": "Given: Force (F) = 150 N, Area (A) = 0.5 m² Formula: Pressure (P) = Force (F) / Area (A) Calculation: P = 150 N / 0.5 m² = 300 N/m² = 300 Pa.",
      "hint": "",
